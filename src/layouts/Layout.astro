---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Japan VMUG vExpert Talks" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Japan VMUG vExpert Talks</title>
    
    <!-- Clarity UI スタイル -->
    <link rel="stylesheet" href="https://unpkg.com/@clr/ui@latest/clr-ui.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/@clr/core@latest/global.min.css" />
    
    <!-- Clarity Core Web Components -->
    <script src="https://unpkg.com/@clr/core@latest/clr-core.min.js"></script>
    
    <style>
      :root {
        --clr-color-action-600: #0072a3;
        --clr-color-success-600: #60b515;
        --clr-color-neutral-0: #ffffff;
        --clr-color-neutral-1000: #1b1d1f;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: var(--clr-color-neutral-1000);
        background-color: var(--clr-color-neutral-0);
      }

      header {
        background: linear-gradient(135deg, #0072a3 0%, #004b87 100%);
        color: white;
        padding: 10px 0 2rem 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        width: 100%;
      }

      header h1 {
        margin: 0;
        padding: 0;
        line-height: 1.1;
        margin-bottom: 0.3rem;
        font-size: 1.5rem;
      }

      header p {
        margin: 0;
        padding: 0;
        line-height: 1.1;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        width: 100%;
      }

      header .container {
        padding: 0 1.5rem;
        width: 100%;
      }

      h1 {
        font-size: 2.5rem;
        margin: 0;
        padding: 0;
      }

      main {
        padding: 3rem 0;
      }

      footer {
        background-color: #f5f5f5;
        padding: 2rem 0;
        margin-top: 4rem;
        border-top: 1px solid #e0e0e0;
        text-align: center;
        font-size: 0.9rem;
        color: #666;
        width: 100%;
      }

      footer .container {
        padding: 0 1.5rem;
      }

      .clr-button {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        background-color: var(--clr-color-action-600);
        color: white;
        text-decoration: none;
        border-radius: 0.3rem;
        margin: 0.5rem 0.5rem 0.5rem 0;
        transition: background-color 0.3s ease;
        border: none;
        cursor: pointer;
      }

      .clr-button:hover {
        background-color: #004b87;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <h1>vExpert が語る - Japan VMUG vExpert Talks</h1>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        <p>@gowatana</p>
      </div>
    </footer>
  </body>
</html>
